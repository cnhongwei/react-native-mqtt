{
  "name": "@cnhongwei/react-native-mqtt",
  "version": "0.1.0",
  "description": "Native MQTT 3.1.1 and 5 client for React Native on Android and iOS",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh-CN.md",
    "!ios/build",
    "!android/build",
    "!android/**/build",
    "!build",
    "!build/**",
    "!openspec",
    "!openspec/**",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/src/test",
    "!android/src/test/**",
    "!android/src/androidTest",
    "!android/src/androidTest/**",
    "!ios/Tests",
    "!ios/Tests/**",
    "!test",
    "!test/**",
    "!examples",
    "!examples/**",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @cnhongwei/react-native-mqtt-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "build": "bob build",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest --runInBand",
    "codegen": "node scripts/codegen.mjs",
    "test:android": "yarn workspace @cnhongwei/react-native-mqtt-example build:android",
    "test:ios": "yarn workspace @cnhongwei/react-native-mqtt-example build:ios",
    "test:ios:scenarios": "swift test --package-path ios/Tests",
    "test:ios:public-matrix": "node scripts/ios-public-matrix.mjs",
    "test:swift-session": "node scripts/swift-session-smoke.mjs",
    "build:android": "yarn workspace @cnhongwei/react-native-mqtt-example android",
    "build:ios": "yarn workspace @cnhongwei/react-native-mqtt-example ios",
    "test:integration": "node scripts/integration.mjs",
    "test:scenarios": "node scripts/scenario-primitives-smoke.mjs",
    "test:examples": "node scripts/example-surface-smoke.mjs",
    "test:diagnostics": "node scripts/diagnostic-safety-smoke.mjs",
    "test:delivery-benchmark": "node scripts/delivery-benchmark.mjs",
    "test:capabilities": "node scripts/backend-capability-smoke.mjs",
    "test:desugaring": "node scripts/desugaring-smoke.mjs",
    "test:manifest": "node scripts/manifest-audit.mjs",
    "test:expo": "node scripts/expo.mjs",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "test:consumer-runtime": "node scripts/consumer-runtime-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "author": "cnhongwei",
  "license": "MIT",
  "homepage": "https://github.com/cnhongwei/react-native-mqtt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnhongwei/react-native-mqtt.git"
  },
  "bugs": {
    "url": "https://github.com/cnhongwei/react-native-mqtt/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@types/jest": "29.5.14",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "0.43.0",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.2.3",
    "react-native": ">=0.86.2"
  },
  "workspaces": [
    "example",
    "examples/expo"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "ReactNativeMqttSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.cnhongwei.reactnativemqtt"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "<%- project.sourceCondition -%>"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest"
    ],
    "version": "0.63.1"
  }
}
